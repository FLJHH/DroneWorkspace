<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <gravity>0 0 -9.8</gravity>
    <physics name="ode" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_update_rate>250</real_time_update_rate>
      <real_time_factor>1</real_time_factor>
    </physics>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.72 0.82 0.92 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 20 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>
    <include><uri>model://ground_plane</uri></include>

    <!-- A solid visual is used instead of Gazebo's road primitive so it is
         visible with every Gazebo/OGRE rendering configuration. -->
    <model name="main_road">
      <static>true</static>
      <pose>0 0 0.025 0 0 0</pose>
      <link name="road">
        <collision name="collision">
          <geometry><box><size>200 7 0.05</size></box></geometry>
        </collision>
        <visual name="asphalt">
          <geometry><box><size>200 7 0.05</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.16 0.16 0.16 1</diffuse>
            <specular>0.02 0.02 0.02 1</specular>
          </material>
        </visual>
        <visual name="center_line">
          <pose>0 0 0.031 0 0 0</pose>
          <geometry><box><size>200 0.10 0.012</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.08 1</ambient>
            <diffuse>1 0.85 0.10 1</diffuse>
          </material>
        </visual>
        <visual name="left_edge_line">
          <pose>0 3.25 0.031 0 0 0</pose>
          <geometry><box><size>200 0.10 0.012</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
        <visual name="right_edge_line">
          <pose>0 -3.25 0.031 0 0 0</pose>
          <geometry><box><size>200 0.10 0.012</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>10 -7 5.5 0 0.48 1.57</pose><view_controller>orbit</view_controller></camera>
    </gui>
  </world>
</sdf>
