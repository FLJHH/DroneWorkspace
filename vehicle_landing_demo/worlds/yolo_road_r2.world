<?xml version="1.0"?>
<sdf version="1.6"><world name="default">
  <gravity>0 0 -9.8</gravity>
  <physics name="ode" type="ode"><max_step_size>0.004</max_step_size><real_time_update_rate>250</real_time_update_rate><real_time_factor>1</real_time_factor></physics>
  <scene><ambient>0.35 0.35 0.35 1</ambient><background>0.92 0.92 0.86 1</background><shadows>true</shadows></scene>
  <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 20 0 0 0</pose><diffuse>1 1 0.92 1</diffuse><specular>0.45 0.45 0.40 1</specular><direction>0.65 0 -0.76</direction></light>
  <include><uri>model://ground_plane</uri></include>
  <plugin name="wind_plugin" filename="libgazebo_wind_plugin.so">
    <frameId>base_link</frameId><robotNamespace/>
    <windVelocityMean>5.0</windVelocityMean><windVelocityMax>5.0</windVelocityMax><windVelocityVariance>0</windVelocityVariance>
    <windDirectionMean>0 1 0</windDirectionMean><windDirectionVariance>0</windDirectionVariance>
    <windGustStart>70</windGustStart><windGustDuration>25</windGustDuration>
    <windGustVelocityMean>2.0</windGustVelocityMean><windGustVelocityMax>2.0</windGustVelocityMax><windGustVelocityVariance>0</windGustVelocityVariance>
    <windGustDirectionMean>0 1 0</windGustDirectionMean><windGustDirectionVariance>0</windGustDirectionVariance><windPubTopic>world_wind</windPubTopic>
  </plugin>
  <model name="main_road"><static>true</static><pose>0 0 0.025 0 0 0</pose><link name="road">
    <collision name="collision"><geometry><box><size>200 7 0.05</size></box></geometry></collision>
    <visual name="asphalt"><geometry><box><size>200 7 0.05</size></box></geometry><material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse></material></visual>
    <visual name="center_line"><pose>0 0 0.031 0 0 0</pose><geometry><box><size>200 0.10 0.012</size></box></geometry><material><ambient>0.95 0.80 0.08 1</ambient><diffuse>1 0.85 0.10 1</diffuse></material></visual>
    <visual name="left_edge_line"><pose>0 3.25 0.031 0 0 0</pose><geometry><box><size>200 0.10 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
    <visual name="right_edge_line"><pose>0 -3.25 0.031 0 0 0</pose><geometry><box><size>200 0.10 0.012</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
  </link></model>
  <gui fullscreen="0"><camera name="user_camera"><pose>10 -7 5.5 0 0.48 1.57</pose><view_controller>orbit</view_controller></camera></gui>
</world></sdf>
