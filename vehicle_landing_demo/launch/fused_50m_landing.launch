<launch>
  <arg name="gui" default="true"/>
  <arg name="visualize_yolo" default="true"/>
  <arg name="cruise_clearance" default="50.0"/>
  <arg name="spawn_x" default="-40"/>
  <arg name="output_name" default="fused_50m_landing.csv"/>
  <arg name="world_name" default="$(find vehicle_landing_demo)/worlds/yolo_road_stable.world"/>
  <arg name="image_topic" default="/iris_0/camera/image_raw"/>
  <arg name="camera_info_topic" default="/iris_0/camera/camera_info"/>
  <arg name="camera_pitch_offset_deg" default="0.0"/>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world_name)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="false"/>
  </include>
  <param name="tagged_vehicle_sdf"
         command="$(find vehicle_landing_demo)/scripts/sdf_scale_tag.py $(find vehicle_landing_demo)/models/tagged_vehicle/model.sdf 0.375"/>
  <node pkg="gazebo_ros" type="spawn_model" name="spawn_tagged_vehicle" output="screen"
        args="-sdf -param tagged_vehicle_sdf -model ugv_0 -x 10 -y 0 -z 0"/>
  <group ns="iris_0">
    <include file="$(find px4)/launch/single_vehicle_spawn_xtd.launch">
      <arg name="x" value="$(arg spawn_x)"/><arg name="y" value="0"/><arg name="z" value="0"/>
      <arg name="R" value="0"/><arg name="P" value="0"/><arg name="Y" value="0"/>
      <arg name="vehicle" value="iris"/><arg name="sdf" value="iris_downward_camera"/>
      <arg name="mavlink_udp_port" value="18570"/><arg name="mavlink_tcp_port" value="4560"/>
      <arg name="cmd" value="$(find vehicle_landing_demo)/scripts/sdf_tilt_camera.py $(find px4)/Tools/sitl_gazebo/models/iris_downward_camera/iris_downward_camera.sdf 4560 13030 $(arg camera_pitch_offset_deg)"/>
      <arg name="ID" value="0"/><arg name="ID_in_group" value="0"/>
    </include>
    <include file="$(find mavros)/launch/px4.launch">
      <arg name="fcu_url" value="udp://:24540@localhost:34580"/>
      <arg name="gcs_url" value=""/><arg name="tgt_system" value="1"/><arg name="tgt_component" value="1"/>
      <arg name="config_yaml" value="$(find mavros)/launch/px4_config_iris_0.yaml"/>
    </include>
    <node pkg="apriltag_ros" type="apriltag_ros_continuous_node" name="apriltag" output="screen">
      <rosparam command="load" file="$(find vehicle_landing_demo)/config/apriltag_settings.yaml"/>
      <rosparam command="load" file="$(find vehicle_landing_demo)/config/apriltag_tags.yaml"/>
      <remap from="image_rect" to="$(arg image_topic)"/>
      <remap from="camera_info" to="$(arg camera_info_topic)"/>
      <param name="camera_frame" value="iris_0/camera_link"/>
      <param name="publish_tag_detections_image" value="true"/>
    </node>
  </group>
  <node pkg="tf" type="static_transform_publisher" name="iris_camera_tf"
        args="0 0 -0.05 -1.5707963 0 -2.3561945 iris_0/base_link iris_0/camera_link 100"/>
  <node pkg="tf" type="static_transform_publisher" name="iris_frd_tf"
        args="0 0 -0.05 3.1415927 0 0 iris_0/base_link iris_0/base_link_frd 100"/>
  <param name="use_gpu" value="true"/>
  <node pkg="vehicle_landing_demo" type="vehicle_yolo.py" name="road_yolo" output="screen">
    <param name="weight_path" value="$(find vehicle_landing_demo)/training/vehicle_yolo11s_descent/weights/best.pt"/>
    <param name="image_topic" value="$(arg image_topic)"/>
    <param name="pub_topic" value="/landing/yolo_boxes"/>
    <param name="camera_frame" value="iris_0/camera_link"/>
    <param name="visualize" value="$(arg visualize_yolo)"/>
    <param name="conf" value="0.3"/><param name="imgsz" value="1280"/>
    <param name="min_vehicle_aspect" value="0.15"/><param name="max_vehicle_aspect" value="2.50"/>
    <param name="tag_handoff_height" value="0.0"/><param name="platform_height" value="2.23"/>
    <param name="debug_dir" value=""/>
  </node>
  <node pkg="vehicle_landing_demo" type="fused_glide_landing.py"
        name="fused_glide_landing" output="screen" required="true">
    <param name="cruise_clearance" value="$(arg cruise_clearance)"/><param name="platform_height" value="2.23"/>
    <param name="takeoff_max_vz" value="3.0"/>
    <param name="descent_speed" value="0.8"/><param name="kp_glide" value="1.2"/>
    <param name="glide_tolerance" value="1.5"/><param name="max_xy_speed" value="2.5"/>
    <param name="image_width" value="1280"/><param name="image_height" value="720"/>
    <param name="tag_frame" value="landing_pad"/>
    <param name="output_file" value="$(find vehicle_landing_demo)/experiments/$(arg output_name)"/>
  </node>
</launch>
